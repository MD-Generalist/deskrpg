# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/.dryforge/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.artifacts/
*.tgz

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# LPC spritesheet assets (downloaded via scripts/download-lpc-assets.sh)
.superpowers/
# .github 은 개발 메타(.claude/.codex 등)와 함께 묶여 무시됐지만, workflows 는
# 저장소 인프라다 — 원격에 파일이 없으면 CI 가 아예 돌지 않는다.
.github/*
!.github/workflows/
.claude/
.codex/
scripts/local/
data/
db.sqlite
:memory-file-not-used:*
*.db
*.db-shm
*.db-wal
# Public Git tree must not contain developer-only instructions or plans.
docs/
AGENTS.md
CLAUDE.md
GEMINI.md
.agents/
.gemini/
e2e/README.md
assets/lpc-office-tilesets/
public/assets/built-in/downloads/
tmp/*
!tmp/.gitkeep
tests/
deploy/
deploy/pre-deploy-checklist.md

# Playwright
/test-results/
/playwright-report/
/blob-report/

# remember 플러그인 런타임 로그·pid — 저장소 산출물이 아니다
.remember/

# Character editing sources (Blender, supplied bases, review captures) — not shipped
/art/
__pycache__/
*.py[cod]

# Public deployment recipes (served via raw URL to Hostinger Docker Manager)
!/deploy/
/deploy/*
!/deploy/hostinger/
!/deploy/office/
deploy/hostinger/catalog-submission.md

# Development meta — never published
/docs/superpowers/

# dryforge 3-doc / worktrees (local only)
/.dryforge
