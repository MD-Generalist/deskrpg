#!/usr/bin/env bash
# 푸시 전 가벼운 게이트 — format:check · typecheck · lint (약 30초).
#
# 켜기:  git config core.hooksPath .githooks   (클론·워크트리마다 한 번)
# 끄기:  git push --no-verify                  (일회성 우회)
#
# 테스트와 build 는 **일부러 뺐다.** 합치면 4~5분이라 푸시마다 물리면 우회가
# 일상이 되고, 그러면 훅이 없는 것과 같다. 이 셋이 CI 가 잡는 실패의 대부분이면서
# 30초 안에 끝난다. 나머지는 CI 가 본다.
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"

# 삭제 푸시는 검사할 것이 없다.
zero="0000000000000000000000000000000000000000"
only_deletes=1
ranges=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue
  only_deletes=0
  # 새 브랜치면 원격 어디에도 없는 커밋만, 아니면 원격 머리 이후 커밋만 본다.
  if [ "$remote_sha" = "$zero" ]; then ranges+=("$local_sha --not --remotes")
  else ranges+=("$remote_sha..$local_sha"); fi
done
[ "$only_deletes" -eq 1 ] && exit 0

# 커밋 메시지의 개발 메타 — 30초 게이트보다 먼저, 몇 밀리초면 끝난다.
# rebase·cherry-pick·병합은 commit-msg 훅을 다시 돌리지 않으므로 공개 전 마지막 관문은 여기다.
meta_failed=0
meta_err="$(mktemp)"
for range in "${ranges[@]}"; do
  # shellcheck disable=SC2086
  for sha in $(git rev-list $range); do
    if ! git log -1 --format=%B "$sha" | bash "$repo/scripts/check-commit-meta.sh" 2>"$meta_err"; then
      printf '\n\033[1;31m[pre-push] %s %s\033[0m\n' "$(git log -1 --format=%h "$sha")" "$(git log -1 --format=%s "$sha")" >&2
      cat "$meta_err" >&2
      meta_failed=1
    fi
  done
done
rm -f "$meta_err"
if [ "$meta_failed" -ne 0 ]; then
  printf '\n\033[1;31m[pre-push] 공개 레포에 개발 메타가 든 커밋을 올리려 한다. 메시지를 고친 뒤(git rebase -i 의 reword) 다시 푸시하라.\033[0m\n' >&2
  exit 1
fi

if [ ! -d "$repo/node_modules" ]; then
  printf '\n\033[1;33m[pre-push] node_modules 가 없어 건너뛴다. `npm ci` 후 다시 푸시하면 검사한다.\033[0m\n'
  exit 0
fi

cd "$repo"
printf '\n\033[1m[pre-push] format:check · typecheck · lint (약 30초). 건너뛰려면 --no-verify.\033[0m\n'

# 로그는 mktemp 로 잡는다. /tmp 에 고정 이름을 쓰면 남이 미리 심볼릭 링크를 걸어
# 엉뚱한 파일을 덮어쓰게 만들 수 있다(공유 머신에서 실제 위험).
log="$(mktemp -t deskrpg-prepush)"
trap 'rm -f "$log"' EXIT

# 셸에 DATABASE_URL 이 있으면 테스트·도구가 그 DB 를 잡는다 — 레포 규약대로 벗긴다.
for step in format:check typecheck lint; do
  printf '  → %s\n' "$step"
  if ! env -u DATABASE_URL npm run -s "$step" >"$log" 2>&1; then
    printf '\n\033[1;31m[pre-push] %s 실패 — 푸시를 막는다.\033[0m\n' "$step"
    tail -30 "$log"
    printf '\n고치고 다시 푸시하거나, 의도적이면 `git push --no-verify`.\n\n'
    exit 1
  fi
done
printf '\033[1;32m[pre-push] 통과 — 푸시한다.\033[0m\n'
