#!/command/with-contenv sh
# Hermes 게이트웨이를 켠다 — DeskRPG 가 붙을 문(8642)을 여는 유일한 주체다.
#
# 공식 이미지는 gateway-default s6 서비스를 등록만 하고 켜지 않는다(실측:
# `s6-svstat /run/service/gateway-default` → `down (not started yet)`).
#
# 두 가지를 실측으로 배웠다:
#   1) cont-init 시점에는 너무 일러 `hermes gateway run` 이 실패한다.
#   2) s6 oneshot 으로 옮겨도 부팅 도중에는 여전히 실패한다 — 이 명령은 살아 있는 감독
#      트리에 서비스를 붙이므로 트리가 자리를 잡은 뒤라야 한다. 나중에 같은 명령을
#      docker exec 로 부르면 곧바로 성공한다.
# 그래서 재시도하고, 부팅을 붙잡지 않도록 up 파일이 이 스크립트를 background 로 돌린다.
set -e

log() { echo "[deskrpg-gateway] $*"; }
DIAG="${HERMES_HOME:-/opt/data}/logs/deskrpg-gateway.log"
mkdir -p "$(dirname "$DIAG")" 2>/dev/null || true

port="$(grep -m1 '^API_SERVER_PORT=' "${HERMES_HOME:-/opt/data}/.env" 2>/dev/null | cut -d= -f2-)"
port="${port:-8642}"

up() { curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$port/v1/models"; }

log "게이트웨이를 켜는 중"
attempt=0
while [ "$attempt" -lt 10 ]; do
    attempt=$((attempt + 1))
    if up; then
        log "게이트웨이가 127.0.0.1:$port 에서 응답한다"
        exit 0
    fi
    # 실패 원인은 화면이 아니라 파일에 남긴다 — 부팅 로그를 어지럽히지 않는다.
    hermes gateway run >>"$DIAG" 2>&1 || log "게이트웨이 기동 시도 $attempt 실패 — 다시 시도한다"
    i=0
    while [ "$i" -lt 10 ]; do
        if up; then
            log "게이트웨이가 127.0.0.1:$port 에서 응답한다 (시도 $attempt)"
            exit 0
        fi
        i=$((i + 1))
        sleep 3
    done
done

log "경고: 게이트웨이가 $port 를 열지 않았다. 자세한 내용은 컨테이너 안 $DIAG"
log "       모델 제공자가 없으면 여기서 멈춘다 — OPENROUTER_API_KEY(또는 OPENAI/ANTHROPIC)를 주거나,"
log "       docker exec -it <컨테이너> hermes model 로 로그인한 뒤 컨테이너를 다시 시작하세요."
