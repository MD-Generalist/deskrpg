# .env.example — copy to .env.local and fill in values
DATABASE_URL=postgresql://deskrpg:deskrpg_dev_pw@localhost:5437/deskrpg
JWT_SECRET=change-me-to-a-random-64-char-string
DESKRPG_IMAGE=dandacompany/deskrpg:latest

# Cookie security: set to "true" for HTTPS deployments, "false" for HTTP/localhost
# COOKIE_SECURE=false

# Optional: Disable public registration (invite-only mode)
# REGISTRATION_DISABLED=true
# NEXT_PUBLIC_REGISTRATION_DISABLED=true

# Optional: SQLite mode (no PostgreSQL needed)
# DB_TYPE=sqlite
# SQLITE_PATH=data/deskrpg.db

# Optional: allow this instance to read Hermes profiles from the HOST filesystem
# (~/.hermes/profiles) for a loopback gateway. OFF by default.
#
# This reads the machine operator's secrets, so owning a gateway record is not
# enough consent — the operator must turn it on here as well, and the gateway's
# URL must be loopback. Do not enable on a multi-user instance where you would
# not hand every member the host's Hermes API keys.
# DESKRPG_LOCAL_DISCOVERY_ENABLED=true

# Optional gateway setup wizard host control. Default OFF; system_admin only.
# Enables local Hermes inspection, plugin preparation and scoped service restart.
# Native local requires python3. SSH requires ssh, configured keys/agent and
# verified known_hosts on the DeskRPG server. See docs/gateway-setup.md.
# DESKRPG_HOST_SETUP_ENABLED=1
# Explicit operator-approved ~/.ssh/config aliases (comma-separated):
# DESKRPG_SETUP_SSH_HOSTS=dev-hermes
